{
  "family": "backend-rag-multipurpose",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::961341555117:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::961341555117:role/ecsTaskRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "961341555117.dkr.ecr.ap-southeast-1.amazonaws.com/sniac_website/rag-nginx:latest",
      "essential": true,
      "cpu": 64,
      "memoryReservation": 128,
      "environment": [
        { "name": "NGINX_UPSTREAM_HOST", "value": "127.0.0.1" },
        { "name": "NGINX_UPSTREAM_PORT", "value": "8000" }
      ],
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "app",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1/nginx-health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend-rag-multipurpose",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "nginx"
        }
      }
    },
    {
      "name": "app",
      "image": "961341555117.dkr.ecr.ap-southeast-1.amazonaws.com/sniac_website/rag-backend:latest",
      "essential": true,
      "cpu": 448,
      "memoryReservation": 896,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "APP_HOST", "value": "0.0.0.0" },
        { "name": "APP_PORT", "value": "8000" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "POSTGRES_HOST", "value": "backend-rag-postgres.cxsuqq4o8xdb.ap-southeast-1.rds.amazonaws.com" },
        { "name": "POSTGRES_PORT", "value": "5432" },
        { "name": "POSTGRES_DB", "value": "ragdb" },
        { "name": "POSTGRES_USER", "value": "postgres" },
        { "name": "REDIS_URL", "value": "rediss://master.backend-rag-redis.rrge6k.apse1.cache.amazonaws.com:6379/0" },
        { "name": "QDRANT_URL", "value": "https://c4e09575-63ef-4fb6-8015-0064275666ed.us-west-1-0.aws.cloud.qdrant.io" },
        { "name": "DEFAULT_GENERATION_PROVIDER", "value": "nim" },
        { "name": "DEFAULT_GENERATION_MODEL", "value": "nvidia/nemotron-3-super-120b-a12b" },
        { "name": "DEFAULT_EMBEDDING_PROVIDER", "value": "nim" },
        { "name": "DEFAULT_EMBEDDING_MODEL", "value": "nvidia/llama-nemotron-embed-1b-v2" },
        { "name": "DEFAULT_EMBEDDING_DIMENSION", "value": "2048" },
        { "name": "RERANK_ENABLED", "value": "true" },
        { "name": "RERANK_MODEL", "value": "nvidia/llama-nemotron-rerank-1b-v2" },
        { "name": "AUTH_ENABLED", "value": "true" },
        { "name": "AUTH_REQUIRE_HTTPS", "value": "true" },
        { "name": "CHAT_DEBUG_ENABLED", "value": "false" },
        { "name": "CHAT_THINKING_ENABLED", "value": "false" },
        { "name": "CHAT_SHOW_THINKING_BLOCK", "value": "false" }
      ],
      "secrets": [
        {
          "name": "NIM_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/NIM_API_KEY"
        },
        {
          "name": "AUTH_JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/AUTH_JWT_SECRET"
        },
        {
          "name": "AUTH_BOOTSTRAP_ADMIN_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/AUTH_BOOTSTRAP_ADMIN_USERNAME"
        },
        {
          "name": "AUTH_BOOTSTRAP_ADMIN_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/AUTH_BOOTSTRAP_ADMIN_PASSWORD"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/POSTGRES_PASSWORD"
        },
        {
          "name": "POSTGRES_DSN",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/POSTGRES_DSN"
        },
        {
          "name": "QDRANT_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:961341555117:parameter/backend-rag/QDRANT_API_KEY"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 45
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend-rag-multipurpose",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
